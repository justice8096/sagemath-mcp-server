# SageMath MCP Server Configuration
TRANSPORT=stdio        # stdio | http
LOG_LEVEL=info         # debug | info | warn | error

# HTTP transport (TRANSPORT=http). API_KEY is required: the server will not
# start in HTTP mode without it. Generate one with: openssl rand -hex 32
# API_KEY=
HOST=127.0.0.1         # interface to listen on; loopback by default
PORT=3000

# SageMath execution
SAGE_EXECUTION_MODE=auto   # auto (Docker first) | local | docker
SAGE_TIMEOUT=120000        # per-call timeout in milliseconds
# SAGE_DOCKER_IMAGE=sagemath/sagemath:latest
# SAGE_DOCKER_NETWORK=none
# SAGE_DOCKER_MEMORY=2g
