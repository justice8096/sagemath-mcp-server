{
  "displayName": "SageMath MCP Server",
  "name": "sagemathmcpserver",
  "icon": "file:icon.svg",
  "group": [
    "transform"
  ],
  "version": 1,
  "description": "MCP server providing symbolic mathematics via SageMath computer algebra system",
  "defaults": {
    "name": "SageMath MCP Server"
  },
  "inputs": [
    "main"
  ],
  "outputs": [
    "main"
  ],
  "properties": [
    {
      "displayName": "Operation",
      "name": "operation",
      "type": "options",
      "options": [
        {
          "name": "Evaluate SageMath Expression",
          "value": "evaluate",
          "description": "Execute arbitrary SageMath expressions and return the computed result"
        },
        {
          "name": "Solve Equation",
          "value": "solve_equation",
          "description": "Solve algebraic and transcendental equations symbolically"
        },
        {
          "name": "Differentiate Expression",
          "value": "differentiate",
          "description": "Compute derivatives of mathematical expressions (partial, higher-order)"
        },
        {
          "name": "Integrate Expression",
          "value": "integrate",
          "description": "Compute indefinite and definite integrals of mathematical expressions"
        },
        {
          "name": "Simplify Expression",
          "value": "simplify",
          "description": "Simplify mathematical expressions using algebraic rules and trigonometric identities"
        },
        {
          "name": "Factor Expression",
          "value": "factor",
          "description": "Factor polynomials and integer expressions"
        },
        {
          "name": "Matrix Operations",
          "value": "matrix_ops",
          "description": "Perform matrix operations: determinant, inverse, eigenvalues, rank, RREF"
        },
        {
          "name": "Generate Mathematical Plot",
          "value": "plot",
          "description": "Generate plots of mathematical functions and return as base64-encoded PNG image"
        },
        {
          "name": "Convert to LaTeX",
          "value": "latex_convert",
          "description": "Convert mathematical expressions to LaTeX notation for document preparation"
        },
        {
          "name": "Number Theory Operations",
          "value": "number_theory",
          "description": "Perform number theory calculations: primality, factorization, divisor functions, and more"
        }
      ],
      "default": "evaluate"
    },
    {
      "displayName": "Expression",
      "name": "expression",
      "type": "string",
      "required": true,
      "default": "",
      "description": "Valid SageMath expression to evaluate",
      "displayOptions": {
        "show": {
          "operation": [
            "evaluate"
          ]
        }
      }
    },
    {
      "displayName": "Equation",
      "name": "equation",
      "type": "string",
      "required": true,
      "default": "",
      "description": "Equation to solve (e.g., 'x^2 - 4 == 0')",
      "displayOptions": {
        "show": {
          "operation": [
            "solve_equation"
          ]
        }
      }
    },
    {
      "displayName": "Variable",
      "name": "variable",
      "type": "string",
      "required": true,
      "default": "",
      "description": "Variable to solve for (e.g., 'x')",
      "displayOptions": {
        "show": {
          "operation": [
            "solve_equation"
