{
  "displayName": "Servidor MCP de SageMath",
  "name": "servidormcpdesagemath",
  "icon": "file:icon.svg",
  "group": [
    "transform"
  ],
  "version": 1,
  "description": "Servidor MCP que proporciona matemática simbólica mediante el sistema de álgebra computacional SageMath",
  "defaults": {
    "name": "Servidor MCP de SageMath"
  },
  "inputs": [
    "main"
  ],
  "outputs": [
    "main"
  ],
  "properties": [
    {
      "displayName": "Operation",
      "name": "operation",
      "type": "options",
      "options": [
        {
          "name": "Evaluar Expresión de SageMath",
          "value": "evaluate",
          "description": "Ejecutar expresiones arbitrarias de SageMath y retornar el resultado computado"
        },
        {
          "name": "Resolver Ecuación",
          "value": "solve_equation",
          "description": "Resolver ecuaciones algebraicas y trascendentales simbólicamente"
        },
        {
          "name": "Diferenciar Expresión",
          "value": "differentiate",
          "description": "Calcular derivadas de expresiones matemáticas (parciales, orden superior)"
        },
        {
          "name": "Integrar Expresión",
          "value": "integrate",
          "description": "Calcular integrales indefinidas y definidas de expresiones matemáticas"
        },
        {
          "name": "Simplificar Expresión",
          "value": "simplify",
          "description": "Simplificar expresiones matemáticas usando reglas algebraicas e identidades trigonométricas"
        },
        {
          "name": "Factorizar Expresión",
          "value": "factor",
          "description": "Factorizar polinomios y expresiones enteras"
        },
        {
          "name": "Operaciones Matriciales",
          "value": "matrix_ops",
          "description": "Realizar operaciones matriciales: determinante, inversa, valores propios, rango, RREF"
        },
        {
          "name": "Generar Gráfico Matemático",
          "value": "plot",
          "description": "Generar gráficos de funciones matemáticas retornando imagen PNG codificada en base64"
        },
        {
          "name": "Convertir a LaTeX",
          "value": "latex_convert",
          "description": "Convertir expresiones matemáticas a notación LaTeX para preparación de documentos"
        },
        {
          "name": "Operaciones de Teoría de Números",
          "value": "number_theory",
          "description": "Realizar cálculos de teoría de números: primalidad, factorización, funciones divisoras"
        }
      ],
      "default": "evaluate"
    },
    {
