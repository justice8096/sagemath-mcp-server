{
  "displayName": "Serveur MCP SageMath",
  "name": "serveurmcpsagemath",
  "icon": "file:icon.svg",
  "group": [
    "transform"
  ],
  "version": 1,
  "description": "Serveur MCP fournissant les mathématiques symboliques via le système d'algèbre informatique SageMath",
  "defaults": {
    "name": "Serveur MCP SageMath"
  },
  "inputs": [
    "main"
  ],
  "outputs": [
    "main"
  ],
  "properties": [
    {
      "displayName": "Operation",
      "name": "operation",
      "type": "options",
      "options": [
        {
          "name": "Évaluer une Expression SageMath",
          "value": "evaluate",
          "description": "Exécuter des expressions SageMath arbitraires et retourner le résultat calculé"
        },
        {
          "name": "Résoudre une Équation",
          "value": "solve_equation",
          "description": "Résoudre des équations algébriques et transcendantales symboliquement"
        },
        {
          "name": "Différencier une Expression",
          "value": "differentiate",
          "description": "Calculer les dérivées d'expressions mathématiques (partielles, d'ordre supérieur)"
        },
        {
          "name": "Intégrer une Expression",
          "value": "integrate",
          "description": "Calculer les intégrales indéfinies et définies d'expressions mathématiques"
        },
        {
          "name": "Simplifier une Expression",
          "value": "simplify",
          "description": "Simplifier les expressions mathématiques en utilisant les règles algébriques et les identités trigonométriques"
        },
        {
          "name": "Factoriser une Expression",
          "value": "factor",
          "description": "Factoriser les polynômes et les expressions entières"
        },
        {
          "name": "Opérations Matricielles",
          "value": "matrix_ops",
          "description": "Effectuer des opérations matricielles: déterminant, inverse, valeurs propres, rang, RREF"
        },
        {
          "name": "Générer un Graphique Mathématique",
          "value": "plot",
          "description": "Générer des graphiques de fonctions mathématiques retournant l'image PNG encodée en base64"
        },
        {
          "name": "Convertir en LaTeX",
          "value": "latex_convert",
          "description": "Convertir les expressions mathématiques en notation LaTeX pour la préparation de documents"
        },
        {
          "name": "Opérations de Théorie des Nombres",
          "value": "number_theory",
          "description": "Effectuer des calculs de théorie des nombres: primalité, factorisation, fonctions diviseurs"
        }
      ],
      "default": "evaluate"
    },
