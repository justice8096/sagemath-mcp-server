{
  "name": "sagemath-mcp-server",
  "version": "1.0.0",
  "description": "MCP server providing symbolic mathematics via SageMath computer algebra system",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "start": "node build/index.js",
    "start:http": "TRANSPORT=http node build/index.js",
    "start:stdio": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:formats": "tsx build.ts",
    "build:claude": "tsx build.ts --format claude-plugin",
    "build:openai": "tsx build.ts --format openai",
    "build:n8n": "tsx build.ts --format n8n",
    "build:mcp": "tsx build.ts --format mcp-server",
    "build:prompts": "tsx build.ts --format prompts",
    "build:cli": "tsx build.ts --format cli",
    "build:locale:es": "tsx build.ts --locale es",
    "build:locale:fr": "tsx build.ts --locale fr",
    "clean": "rm -rf dist",
    "validate": "tsx build.ts --validate-only",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "bin": {
    "sagemath-mcp": "./build/index.js"
  },
  "files": [
    "build/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justice8096/sagemath-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "sagemath",
    "math",
    "computer-algebra",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "Justice E. Chase"
}
